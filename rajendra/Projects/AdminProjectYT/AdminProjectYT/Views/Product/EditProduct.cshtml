@model AdminProjectYT.Models.Products

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-5">

    <div class="row justify-content-center ">
        <div class="col-md-6">

            <div class="card shadow-lg">
                <div class="card-header text-center">
                    <h5 class="mb-0">Edit Product</h5>
                </div>

                <div class="card-body">
                    <form asp-controller="Product" asp-action="EditProduct" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" name="name" placeholder="Enter product name" value="@Model.Name"/>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" name="description" class="form-control" rows="3"
                                      placeholder="Enter product description" >@Model.Description</textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price" name="price" type="number" step="0.01"
                                   class="form-control" placeholder="Enter price" value="@Model.Price" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Color" class="form-label fw-semibold"></label>
                            <input asp-for="Color" name="color" class="form-control" value="@Model.Color" placeholder="Enter color" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>
                        <input type="hidden" name="productid" value="@Model.ProductId"/>
                        <div class="d-flex gap-5 justify-content-between">

                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="btn btn-secondary w-100">
                                ← Back
                            </a>


                            <button type="submit"
                                    name="submitType"
                                    value="save"
                                    class="btn btn-success w-100">
                                Update
                            </button>




                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

